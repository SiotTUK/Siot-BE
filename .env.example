# 복사해서 사용: cp .env.example .env   (.env 는 git에 커밋하지 않는다)

# Spring 프로필: local | prod
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
DB_NAME=siot
DB_USERNAME=siot
DB_PASSWORD=change-me
DB_PORT=5432
# IDE에서 직접 실행할 때만 사용 (compose 안에서는 자동 설정)
DB_URL=jdbc:postgresql://localhost:5432/siot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Session
SESSION_TIMEOUT=14d

# Backend 컨테이너
BACKEND_PORT=8080
BACKEND_IMAGE=ghcr.io/siottuk/siot-backend:latest

# 예약 작업 (기본값 사용 시 생략 가능)
# SCHEDULING_ENABLED=true
# EVENT_COLLECT_CRON=0 0 3 * * *
# NOTIFICATION_DISPATCH_INTERVAL=1m

# 메일 (비워 두면 로컬은 localhost:1025, compose 는 mailpit 사용)
# 운영 Gmail SMTP 예시 (docs/deployment.md 참고):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=team.siot@gmail.com
# MAIL_PASSWORD=<Gmail 앱 비밀번호 16자리>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=웰컴시흥 <team.siot@gmail.com>

# 메일 링크에 쓰는 프론트엔드 주소
# FRONTEND_BASE_URL=http://localhost:5173
