# 복사해서 사용: cp .env.example .env   (.env 는 git에 커밋하지 않는다)

# Spring 프로필: local | prod
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
DB_NAME=siot
DB_USERNAME=siot
DB_PASSWORD=change-me
DB_PORT=5432
# IDE에서 직접 실행할 때만 사용 (compose 안에서는 자동 설정)
DB_URL=jdbc:postgresql://localhost:5432/siot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Session
SESSION_TIMEOUT=14d

# Backend 컨테이너
BACKEND_PORT=8080
BACKEND_IMAGE=asia-northeast3-docker.pkg.dev/siot-514601/siot/siot-backend:latest

# 예약 작업 (기본값 사용 시 생략 가능)
# SCHEDULING_ENABLED=true
# EVENT_COLLECT_CRON=0 0 3 * * *
# NOTIFICATION_DISPATCH_INTERVAL=1m

# 메일 (비워 두면 로컬은 localhost:1025, compose 는 mailpit 사용)
# 운영 Gmail SMTP 예시 (docs/deployment.md 참고):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=team.siot@gmail.com
# MAIL_PASSWORD=<Gmail 앱 비밀번호 16자리>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=웰컴시흥 <team.siot@gmail.com>

# 메일 링크에 쓰는 프론트엔드 주소
# FRONTEND_BASE_URL=http://localhost:5173

# Gemini (챗봇·번역·문서 적재가 같이 쓴다). 둘 다 비우면 챗봇은 안내 문구로만 응답하고 번역·적재는 실패한다
# Vertex AI: 프로젝트 ID 를 넣으면 우선 사용. 인증은 ADC (VM 은 서비스 계정, 로컬은 gcloud auth application-default login)
# GEMINI_PROJECT_ID=siot-514601
# GEMINI_LOCATION=global
# AI Studio API 키 (GEMINI_PROJECT_ID 가 비어 있을 때만 사용)
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# 고지서 사진 번역(RUL-07) 전용 모델. 비우면 GEMINI_CHAT_MODEL 을 쓴다
# GEMINI_BILL_MODEL=
# 고지서 사진 읽기 1회 호출 제한 시간 (기본 75s)
# GEMINI_BILL_TIMEOUT=75s
# CHATBOT_MIN_RELEVANCE=0.6

# 행사 수집 (EVE-01): 공공데이터포털 키. TourAPI(한국관광공사 국문 관광정보)·전국문화축제표준데이터 활용 신청이 필요하다.
# 비우면 두 출처는 수집 실패(FAILED)로 기록된다. 경기문화재단 지지씨는 키 없이 수집한다
# EVENT_API_KEY=

# 사용자에게 보여 주는 행사 지역 (기본 SIHEUNG: 시흥 행사만). SIHEUNG,GYEONGGI면 지금과 같은 동작
# (경기도 행사도 보임). 수집과 관리자 API 는 이 값과 상관없이 모든 지역. 바꾸면 backend 컨테이너를 다시 만들어야 적용된다
# EVENT_PUBLIC_REGIONS=SIHEUNG

# 공휴일 (세금 마감일 계산): 공공데이터포털 '한국천문연구원_특일 정보' 활용 신청이 필요하다.
# 비우면 EVENT_API_KEY 를 같이 쓰고, 둘 다 없거나 활용 신청이 안 됐으면 주말·양력 고정 공휴일만 반영한다
# HOLIDAY_API_KEY=

# 문서 적재 (ADM-02): 업로드한 PDF 저장 폴더. 실패 버전 재실행에 원본이 필요하므로 지우지 않는다
# DOCUMENT_STORAGE_DIR=./data/documents

# 관리자로 지정할 이메일 (쉼표 구분, 가입 시 또는 앱 시작 시 관리자가 됨)
# SIOT_ADMIN_EMAILS=admin@example.com

# API 문서 Swagger UI (/swagger-ui.html). compose 는 prod 프로필이라 기본 꺼짐. 로컬에서 보려면 true
# SWAGGER_ENABLED=true
